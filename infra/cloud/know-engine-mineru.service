[Unit]
Description=Know Engine MinerU PDF and Word parser
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=know-engine-mineru
Group=know-engine-mineru
WorkingDirectory=/opt/know-engine-mineru
Environment=HOME=/opt/know-engine-mineru
Environment=PYTHONUNBUFFERED=1
Environment=MINERU_MODEL_SOURCE=modelscope
Environment=MINERU_DEVICE_MODE=cpu
Environment=MINERU_FORMULA_ENABLE=false
Environment=MINERU_API_MAX_CONCURRENT_REQUESTS=1
Environment=MINERU_PROCESSING_WINDOW_SIZE=1
Environment=MINERU_API_OUTPUT_ROOT=/opt/know-engine-mineru/output
Environment=OMP_NUM_THREADS=2
Environment=MKL_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=2
Environment=NUMEXPR_NUM_THREADS=2
Environment=HF_HUB_DISABLE_TELEMETRY=1
ExecStart=/opt/know-engine-mineru/venv/bin/mineru-api --host 127.0.0.1 --port 18000
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
MemoryHigh=4G
MemoryMax=4608M
MemorySwapMax=1G
CPUQuota=200%
TasksMax=128
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/know-engine-mineru

[Install]
WantedBy=multi-user.target
